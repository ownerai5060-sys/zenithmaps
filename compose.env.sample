# Copy to compose.env (gitignored via .env patterns) or export before:
#   docker compose --env-file compose.env up --build
#   ./scripts/compose_smoke.sh
#
# Demo secrets only — replace before any shared/staging use.
# Demo API key for smoke (built into api defaults; override via ZENITH_API_KEYS):
#   X-API-Key: zenith_demo_key_layers_read

POSTGRES_USER=zenith
POSTGRES_PASSWORD=zenith_local_change_me
POSTGRES_DB=zenith

# API
ZENITH_PUBLIC_BASE_URL=http://127.0.0.1:8000
ZENITH_KEY_VAULT_PATH=/.data/keys.sqlite
ZENITH_WEBHOOK_LOG_PATH=/.data/webhooks.sqlite
ZENITH_REDIS_URL=redis://redis:6379/0
ZENITH_DATABASE_URL=postgresql://zenith:zenith_local_change_me@postgis:5432/zenith
ZENITH_MIGRATE_ON_START=true
ZENITH_RATE_LIMIT_BACKEND=redis
ZENITH_SESSION_STORE_BACKEND=redis
ZENITH_OTEL_ENABLED=true
ZENITH_OTEL_SERVICE_NAME=zenith-api
ZENITH_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
ZENITH_HEALTH_CHECK_UPSTREAMS=false
# Optional: force webhook POSTs through the allowlist sidecar (profile: egress)
# HTTP_PROXY=http://egress-allowlist:8888
# HTTPS_PROXY=http://egress-allowlist:8888
# NO_PROXY=redis,postgis,otel-collector,localhost,127.0.0.1
# ZENITH_WEBHOOK_ALLOWED_HOSTS=hooks.example.com
# EGRESS_ALLOWED_HOSTS=hooks.example.com
