# Sample env for Zenith API → OpenTelemetry collector (OTLP HTTP).
# Copy values into your process environment; do not commit real secrets.
#
# 1) Install optional packages:
#      pip install -r requirements-api.txt -r requirements-api-extras.txt
# 2) Run a collector that accepts OTLP HTTP (default :4318), e.g.:
#      otelcol --config /path/to/otel-collector-config.yaml
# 3) Point the API at the collector traces endpoint:

ZENITH_OTEL_ENABLED=true
ZENITH_OTEL_SERVICE_NAME=zenith-api
# OTLP HTTP traces path — adjust host/port to your collector
ZENITH_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Minimal collector config sketch (YAML, not env) for local smoke:
#
# receivers:
#   otlp:
#     protocols:
#       http:
#         endpoint: 0.0.0.0:4318
# exporters:
#   debug:
#     verbosity: basic
# service:
#   pipelines:
#     traces:
#       receivers: [otlp]
#       exporters: [debug]
#
# Production: replace debug exporter with your backend (Tempo, Jaeger,
# Honeycomb, etc.). Zenith does not ship a managed collector.
